        </activity>
        <service android:name=".offline.OfflineDownloadService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".offline.AutomaticSourceDownloadService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
        <service android:name=".sync.ShelfSyncService" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="true" />
    </application>
</manifest>
